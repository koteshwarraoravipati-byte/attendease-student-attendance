FLASK_APP=app.py
FLASK_DEBUG=1
# Use a long random value outside local development.
JWT_SECRET_KEY=change-this-secret-key-to-a-random-32-character-value
# Default local database (no Docker required):
DATABASE_URL=sqlite:///attendance.db
# Production PostgreSQL (Supabase, Neon, or another managed provider):
# DATABASE_URL=postgresql://postgres:password@host:5432/postgres
# SQLAlchemy automatically converts postgres:// and postgresql:// to psycopg2.
# Optional MySQL-compatible setting:
# DATABASE_URL=mysql+pymysql://attendance_user:attendance_pass@localhost:3306/attendance_db
MONGO_URI=mongodb://localhost:27017/
MONGO_DB=attendease_logs
# Local seed only; never add these to GitHub or the frontend.
ADMIN_PASSWORD=choose-a-local-admin-password
FACULTY_PASSWORD=choose-a-local-faculty-password
STUDENT_PASSWORD=choose-a-local-student-password
