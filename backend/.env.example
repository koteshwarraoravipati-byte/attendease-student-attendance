FLASK_APP=app.py
FLASK_DEBUG=1
# Use a long random value outside local development.
JWT_SECRET_KEY=change-this-secret-key-to-a-random-32-character-value
# Default local database (no Docker required):
DATABASE_URL=sqlite:///attendance.db
# Production PostgreSQL (Supabase, Neon, or another managed provider):
# DATABASE_URL=postgresql://postgres:password@host:5432/postgres
# SQLAlchemy automatically converts postgres:// and postgresql:// to psycopg2.
# Optional MySQL-compatible setting:
# DATABASE_URL=mysql+pymysql://attendance_user:attendance_pass@localhost:3306/attendance_db
# MongoDB Atlas activity-log storage (optional in local development)
# MONGODB_URI=mongodb+srv://user:password@cluster.example.mongodb.net/?retryWrites=true&w=majority
# MONGODB_DB=attendease_logs
# Legacy names MONGO_URI and MONGO_DB are also supported.
# Comma-separated deployed frontend origins; keep * only for local development.
CORS_ORIGINS=http://localhost:5173
# Local seed only; never add these to GitHub or the frontend.
ADMIN_PASSWORD=choose-a-local-admin-password
FACULTY_PASSWORD=choose-a-local-faculty-password
STUDENT_PASSWORD=choose-a-local-student-password

# Password recovery: server-only SMTP configuration. Never use VITE_ for secrets.
PASSWORD_MAIL_PROVIDER=smtp
FRONTEND_URL=https://your-trusted-frontend.example
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
# Use SMTP_SECURITY=ssl and port 465 if required by your provider.
# Plaintext SMTP is rejected outside loopback TESTING mode.
# For the isolated local inbox, use local_password_demo.py instead of editing .env.
